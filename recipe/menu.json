{
    "$schema": "https://schemas.conda.org/menuinst/menuinst-1-1-3.schema.json",
    "menu_name": "Anaconda ({{ DISTRIBUTION_NAME }})",
    "menu_items": [
        {
            "name": "Anaconda Prompt__ENV_PLACEHOLDER__",
            "command": [
                "{{ PREFIX }}/bin/anaconda_prompt"
            ],
            "activate": false,
            "terminal": false,
            "icon": "{{ MENU_DIR }}/anaconda_prompt.{{ ICON_EXT }}",
            "description": "Launches a terminal window with conda activated.",
            "platforms": {
                "win": {
		            "desktop": false,
                    "terminal_profile": "Anaconda Prompt ({{ DISTRIBUTION_NAME }}__ENV_PLACEHOLDER_TERMINAL__)",
                    "app_user_model_id": "anaconda.CmdExe.{{ DISTRIBUTION_NAME }}.{{ ENV_NAME }}",
                    "command": [
                        "%WINDIR%\\System32\\cmd.exe",
                        "/K",
                        "{{ BASE_PREFIX }}\\Scripts\\activate.bat",
                        "{{ PREFIX }}"
                    ],
                    "working_dir": "%USERPROFILE%"
                },
                "osx": {
                    "entitlements": [
                        "com.apple.security.automation.apple-events"
                    ]
                }
            }
        }
    ]
}
